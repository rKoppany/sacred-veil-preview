---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  preloadImages?: Array<string | { href: string; srcset?: string; sizes?: string }>;
}

const { title, description, preloadImages = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const withBaseUrl = (path: string) => `${baseUrl}${path}`;
const withBaseUrlSrcset = (srcset: string) =>
  srcset
    .split(",")
    .map((candidate) => {
      const [path, descriptor] = candidate.trim().split(/\s+/, 2);
      return `${withBaseUrl(path)} ${descriptor ?? ""}`.trim();
    })
    .join(", ");
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf7ef" />
    <link rel="preload" as="image" href={`${baseUrl}images/brand/sacred-veil-logo-transparent-192.webp?v=20260802`} />
    {preloadImages.map((image) => (
      typeof image === "string" ? (
        <link rel="preload" as="image" href={withBaseUrl(image)} />
      ) : (
        <link
          rel="preload"
          as="image"
          href={withBaseUrl(image.href)}
          imagesrcset={image.srcset ? withBaseUrlSrcset(image.srcset) : undefined}
          imagesizes={image.sizes}
        />
      )
    ))}
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline src={`${baseUrl}js/veil-transition.min.js?v=32`} defer></script>
  </body>
</html>
